# Google AI Studio Gemini API Key (REQUIRED — server-side only, never exposed to browser)
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the auto-discovered Gemini Live native audio model
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Optional: Choose Gemini Live voice (Charon, Fenrir, Puck, Kore, Aoede, Zephyr)
# GEMINI_LIVE_VOICE=Charon

# Optional (recommended for public Vercel URLs):
# Locks /api/live-token behind a minimalist passcode gate so only you can use your API key.
# Leave blank for zero-UI instant tap-to-talk access.
JARVIS_ACCESS_PASSCODE=

# Optional (recommended when JARVIS_ACCESS_PASSCODE is set):
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
