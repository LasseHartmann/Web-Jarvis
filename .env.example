# ==============================================================================
# 1. CORE GEMINI API (REQUIRED)
# ==============================================================================
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides:
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_THINK_MODEL=gemini-3.1-pro-preview
# GEMINI_LIVE_VOICE=Charon

# Optional production base URL (e.g. https://web-jarvis.vercel.app) for OAuth callbacks
# APP_URL=https://your-app.vercel.app

# ==============================================================================
# 2. OPTIONAL ACCESS CLEARANCE GATE (RECOMMENDED FOR PUBLIC VERCEL URLS)
# ==============================================================================
JARVIS_ACCESS_PASSCODE=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ==============================================================================
# 3. OPTIONAL UPSTASH REDIS (CROSS-DEVICE MEMORY + AUTO OAUTH TOKEN STORAGE + WHATSAPP INBOX)
# ==============================================================================
# Free tier at https://console.upstash.com (or Vercel Marketplace -> Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# 4. SPOTIFY CONNECT & PLAYBACK CONTROL
# ==============================================================================
# Create an app at https://developer.spotify.com/dashboard
# Redirect URI: https://<your-vercel-domain>/api/oauth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional if NOT using Upstash Redis (printed once after visiting /api/oauth/spotify/start):
SPOTIFY_REFRESH_TOKEN=

# ==============================================================================
# 5. GOOGLE SERVICES (CALENDAR, GMAIL, GOOGLE TASKS)
# ==============================================================================
# Create OAuth 2.0 Web Client in Google Cloud Console (enable Calendar, Gmail & Tasks APIs)
# Redirect URI: https://<your-vercel-domain>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional if NOT using Upstash Redis (printed once after visiting /api/oauth/google/start):
GOOGLE_REFRESH_TOKEN=

# Optional: Upgrades nearby places search from free OpenStreetMap to Google Places API
GOOGLE_MAPS_API_KEY=

# ==============================================================================
# 6. WHATSAPP (META WHATSAPP CLOUD API)
# ==============================================================================
# Create a Meta Developer App with WhatsApp product at https://developers.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional default recipient for "text myself" (international format, e.g. +491701234567)
WHATSAPP_DEFAULT_RECIPIENT=
# Optional JSON nickname-to-phone map, e.g. {"mom":"+491701234567","alex":"+491519876543"}
WHATSAPP_CONTACTS_JSON=
# Optional webhook settings for reading incoming messages (point webhook to /api/webhooks/whatsapp):
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ==============================================================================
# 7. GITHUB
# ==============================================================================
# Create a Fine-Grained or Classic PAT at https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=LasseHartmann
GITHUB_DEFAULT_REPO=Web-Jarvis

# ==============================================================================
# 8. VERCEL
# ==============================================================================
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_DEFAULT_PROJECT=web-jarvis
# Optional (only if using a Vercel Team):
VERCEL_TEAM_ID=
