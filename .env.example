# Google AI Studio Gemini API Key (REQUIRED — server-side only, never exposed to browser)
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default models (leave blank to use built-in defaults)
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Recommended for public Vercel deployments:
# Protects your server GEMINI_API_KEY behind the J.A.R.V.I.S. Security Clearance Gate.
# Leave blank locally if you want instant unlocked access on localhost.
JARVIS_ACCESS_PASSCODE=

# Recommended when JARVIS_ACCESS_PASSCODE is set:
# Random 32+ character string used to sign clearance session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
